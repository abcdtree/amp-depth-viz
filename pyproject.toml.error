[tool.poetry]
name = "amp-depth-viz" ## Change to your project's name
version = "0.1.2"
description = "A short description of your package"
readme = "README.md"
authors = [
    {name = "Josh Zhang", email = "josh.zhang@mh.org.au"},
]
#include = ["amp_depth_viz/template/*", ]# Tells poetry where to find the package source
packages = [
    { include = "amp_depth_viz" },
    { include = "amp_depth_viz/template/*" },
]

[tool.poetry.dependencies]
python = "^3.9"
bokeh = "^3.8.1"
scipy = "1.16.3"
pandas = "^2.3.3"
numpy = "^2.3.5"

[tool.poetry.scripts]
amp-depth-viz = "amp_depth_viz.main:main"

[build-system]
requires = ["poetry-core>=2.2.1"]
build-backend = "poetry.core.masonry.api"